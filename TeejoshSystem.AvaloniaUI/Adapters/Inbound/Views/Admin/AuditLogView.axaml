<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Admin.AuditLogView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="#FF9800" Padding="24,16">
            <TextBlock Text="Historial de Cambios"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="4">
            <Grid RowDefinitions="Auto,*">

                <StackPanel Grid.Row="0" Margin="24,24,24,16">
                    <Grid ColumnDefinitions="*,16,*,16,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding FiltroEntidad}"
                                 Watermark="Entidad (ej. Producto)"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding FiltroUsuario}"
                                 Watermark="Usuario"/>
                        <Button Grid.Column="4"
                                Command="{Binding CargarCommand}"
                                Content="Buscar"
                                Background="#FF9800"
                                Foreground="White"
                                Height="40" Padding="24,0"/>
                    </Grid>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Entradas}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          Margin="24,0,24,24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Timestamp}"
                                            Width="160"/>
                        <DataGridTextColumn Header="Usuario"
                                            Binding="{Binding Usuario}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Entidad"
                                            Binding="{Binding Entidad}"
                                            Width="120"/>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding EntidadId}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Acción"
                                            Binding="{Binding Accion}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Cambios"
                                            Binding="{Binding Cambios}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,16" Background="White" Padding="16">
            <Button Command="{Binding VolverCommand}"
                    Content="Volver"
                    Height="40" Padding="24,0"
                    HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>