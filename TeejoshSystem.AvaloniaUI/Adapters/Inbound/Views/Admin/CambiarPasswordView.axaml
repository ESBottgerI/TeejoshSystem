<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Admin"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Admin.CambiarPasswordView"
             x:DataType="vm:CambiarPasswordViewModel">

     <Grid HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Width="300">

          <StackPanel Spacing="12">

               <TextBlock Text="Cambiar contraseña"
                          Theme="{StaticResource SectionTitle}"
                          Margin="0,0,0,8"/>

               <StackPanel Spacing="4">
                    <TextBlock Text="Contraseña actual" Theme="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PasswordActualBox"
                             PasswordChar="●"
                             IsEnabled="{Binding !IsBusy}"/>
               </StackPanel>

               <StackPanel Spacing="4">
                    <TextBlock Text="Contraseña nueva" Theme="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PasswordNuevoBox"
                             PasswordChar="●"
                             IsEnabled="{Binding !IsBusy}"/>
               </StackPanel>

               <StackPanel Spacing="4">
                    <TextBlock Text="Confirmar contraseña nueva" Theme="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ConfirmarPasswordBox"
                             PasswordChar="●"
                             IsEnabled="{Binding !IsBusy}"/>
               </StackPanel>

               <TextBlock Text="{Binding MensajeError}"
                          Theme="{StaticResource ValidationError}"
                          TextWrapping="Wrap"
                          IsVisible="{Binding MensajeError,
                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

               <Button Content="Cambiar contraseña"
                       Command="{Binding CambiarPasswordCommand}"
                       Theme="{StaticResource BrandButton}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"/>

               <Button Content="Volver"
                       Command="{Binding VolverCommand}"
                       Theme="{StaticResource StandardButton}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"/>

               <ProgressBar IsIndeterminate="True"
                            IsVisible="{Binding IsBusy}"
                            Height="4"/>

          </StackPanel>
     </Grid>
</UserControl>
