<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Catalogos.SincronizarCatalogosView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="{DynamicResource TeejoshPrimaryBrush}" Padding="24,16">
            <TextBlock Text="Sincronizar Catálogos"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="16" Theme="{StaticResource ContentPanel}">
            <StackPanel Margin="24" Spacing="16">

                <TextBlock Text="Sincronización de catálogos TCG"
                           Theme="{StaticResource SectionTitle}"/>

                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TeejoshMutedBrush}">
                    Conecta con TCGdex (Pokémon), Scryfall (Magic) y YGOProDeck (Yu-Gi-Oh!)
                    para actualizar las expansiones disponibles.
                    One Piece y Bluey se gestionan manualmente.
                </TextBlock>

                <!-- Resultado -->
                <Border Background="{DynamicResource TeejoshBackgroundBrush}" CornerRadius="4" Padding="16"
                        IsVisible="{Binding Resultado,
                        Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Resultado:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resultado}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Loading -->
                <StackPanel Orientation="Horizontal" Spacing="12"
                            IsVisible="{Binding IsBusy}">
                    <ProgressBar IsIndeterminate="True" Width="24" Height="24"/>
                    <TextBlock Text="Sincronizando expansiones..."
                               VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,16" Theme="{StaticResource FooterPanel}">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <Button Grid.Column="1"
                        Command="{Binding SincronizarCommand}"
                        Content="Sincronizar ahora"
                        Theme="{StaticResource BrandButton}"
                        IsEnabled="{Binding IsBusy,
                        Converter={x:Static BoolConverters.Not}}"/>

                <Button Grid.Column="3"
                        Command="{Binding VolverCommand}"
                        Theme="{StaticResource StandardButton}"
                        Content="Volver"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
