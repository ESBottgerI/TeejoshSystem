<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Menu"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Menu.MenuPrincipalView"
             x:DataType="vm:MenuPrincipalViewModel">

        <StackPanel Margin="20" Spacing="15">

                <!-- Encabezado de identidad estructurado -->
                <Border Background="{DynamicResource TeejoshHeaderDarkBrush}" Padding="12,8" CornerRadius="4">
                        <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="TeejoshSystem"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding VersionApp}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TeejoshMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding UsuarioActivo}"
                                           FontSize="13"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                        </Grid>
                </Border>

                <TextBlock Text="Menú Principal"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <!-- Opciones disponibles para todos los usuarios -->
                <Button Content="Ver Inventario"
                        Command="{Binding VisualizarInventarioCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center" Margin="0,10"/>

                <Button Content="Gestionar Productos"
                        Command="{Binding ModificarProductoCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"
                        IsVisible="{Binding EsAdministrador}"/>

                <Button Content="Añadir Producto"
                        Command="{Binding AnadirProductoCommand}"
                        Theme="{DynamicResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"
                        IsVisible="{Binding EsAdministrador}"/>

                <Button Content="Registrar Venta"
                        Command="{Binding RegistrarVentaCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"/>

                <Button Content="Historial de Ventas"
                        Command="{Binding VerHistorialVentasCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"/>

                <Button Content="Cambiar Contraseña"
                        Command="{Binding IrACambiarPasswordCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"/>

                <!-- Separador visual — solo visible para administrador -->
                <Separator IsVisible="{Binding EsAdministrador}"
                           Margin="0,8"/>

                <TextBlock Text="Administración"
                           Theme="{StaticResource FieldLabel}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding EsAdministrador}"/>

                <!-- Opciones exclusivas de administrador -->
                <Button Content="Gestionar Usuarios"
                        Command="{Binding IrAGestionarUsuariosCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"
                        IsVisible="{Binding EsAdministrador}"/>

                <Separator Margin="0,8"/>

                <Button Content="Sincronizar catálogos"
                        Command="{Binding SincronizarCatalogosCommand}"
                        Theme="{StaticResource StandardButton}"
                        Width="200" HorizontalAlignment="Center"
                        IsVisible="{Binding EsAdministrador}"/>

                <Separator Margin="0,8"/>

                <Button Content="Cerrar sesión"
                        Command="{Binding CerrarSesionCommand}"
                        Theme="{StaticResource DangerButton}"
                        Width="200" HorizontalAlignment="Center"/>

        </StackPanel>
</UserControl>
