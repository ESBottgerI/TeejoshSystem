<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.CrearProductoView"
             x:DataType="vm:CrearProductoViewModel">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Header -->
		<Border Grid.Row="0" Background="#FF9800" Padding="24,16">
			<TextBlock Text="Crear Producto"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
		</Border>

		<!-- Formulario -->
		<ScrollViewer Grid.Row="1" Margin="16">
			<Border Background="{DynamicResource TeejoshSurfaceBrush}" CornerRadius="4">
				<StackPanel Margin="24" Spacing="12">

					<!-- Datos comunes -->
					<TextBlock Text="Datos Generales"
                               FontSize="16" FontWeight="SemiBold"/>

					<StackPanel Spacing="2">
						<TextBlock Text="Tipo de producto"/>
						<ComboBox ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoSeleccionado}"
                                  DisplayMemberBinding="{Binding Nombre}"
                                  HorizontalAlignment="Stretch"/>
					</StackPanel>

					<StackPanel Spacing="2">
						<TextBlock Text="Nombre"/>
						<DataValidationErrors>
							<TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
									 Watermark="Nombre del producto"/>
						</DataValidationErrors>
					</StackPanel>

					<Grid ColumnDefinitions="*,16,*">
						<StackPanel Grid.Column="0" Spacing="4">
							<TextBlock Text="Precio"/>
							<DataValidationErrors>
								<NumericUpDown Value="{Binding Precio}"
											   Minimum="0"
											   FormatString="F2"
											   Increment="0.5"/>
							</DataValidationErrors>
						</StackPanel>

						<StackPanel Grid.Column="2" Spacing="4">
							<TextBlock Text="Unidades"/>
							<DataValidationErrors>
								<NumericUpDown Value="{Binding Unidades}"
											   Minimum="0"
											   Increment="1"
											   FormatString="F0"/>
							</DataValidationErrors>
						</StackPanel>
					</Grid>

					<!-- Panel Hot Wheels -->
					<StackPanel Spacing="12"
                                IsVisible="{Binding MostrarHotWheels}">
						<TextBlock Text="Detalles Hot Wheels"
                                   FontSize="16" FontWeight="SemiBold"/>

						<StackPanel Spacing="2">
							<TextBlock Text="Modelo"/>
							<DataValidationErrors>
								<TextBox Text="{Binding HwModelo, UpdateSourceTrigger=PropertyChanged}"
										 Watermark="Ej: Ford Mustang"/>
							</DataValidationErrors>
						</StackPanel>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Año"/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding HwAnio}"
												   Minimum="1967"
												   Increment="1"
												   FormatString="F0"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Serie"/>
								<DataValidationErrors>
									<TextBox Text="{Binding HwSerie, UpdateSourceTrigger=PropertyChanged}"
											 Watermark="Ej: HW Race Team"/>
								</DataValidationErrors>
							</StackPanel>
						</Grid>

						<StackPanel Spacing="2">
							<TextBlock Text="Categoría"/>
							<ComboBox ItemsSource="{Binding CategoriasHotWheels}"
                                      SelectedItem="{Binding HwCategoriaSeleccionada}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
						</StackPanel>
					</StackPanel>

					<!-- Panel Funko -->
					<StackPanel Spacing="12"
                                IsVisible="{Binding MostrarFunko}">
						<TextBlock Text="Detalles Funko"
                                   FontSize="16" FontWeight="SemiBold"/>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Número de caja"/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding FunkoNumeroBox}"
												   Minimum="0"
												   Increment="1"
												   FormatString="F0"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Licencia"/>
								<DataValidationErrors>
									<TextBox Text="{Binding FunkoLicencia, UpdateSourceTrigger=PropertyChanged}"
											 Watermark="Ej: Marvel"/>
								</DataValidationErrors>
							</StackPanel>
						</Grid>

						<StackPanel Spacing="4">
							<TextBlock Text="Subtipo"/>
							<ComboBox ItemsSource="{Binding SubtiposFunko}"
                                      SelectedItem="{Binding FunkoSubtipoSeleccionado}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
						</StackPanel>

						<StackPanel Spacing="4">
							<TextBlock Text="Característica especial (opcional)"/>
							<ComboBox ItemsSource="{Binding CaracteristicasFunko}"
                                      SelectedItem="{Binding FunkoCaracteristicaSeleccionada}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
						</StackPanel>
					</StackPanel>

					<!-- Panel TCG -->
					<StackPanel Spacing="16"
                                IsVisible="{Binding MostrarTcg}">
						<TextBlock Text="Detalles TCG"
                                   FontSize="16" FontWeight="SemiBold"/>

						<StackPanel Spacing="4">
							<TextBlock Text="Franquicia"/>
							<ComboBox ItemsSource="{Binding FranquiciasTcg}"
                                      SelectedItem="{Binding TcgFranquiciaSeleccionada}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Expansión"/>
								<ComboBox ItemsSource="{Binding TcgExpansionesDisponibles}"
                                          SelectedItem="{Binding TcgExpansionSeleccionada}"
                                          DisplayMemberBinding="{Binding Nombre}"
                                          HorizontalAlignment="Stretch"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Pack"/>
								<ComboBox ItemsSource="{Binding TcgPacksDisponibles}"
                                          SelectedItem="{Binding TcgPackSeleccionado}"
                                          DisplayMemberBinding="{Binding Nombre}"
                                          HorizontalAlignment="Stretch"/>
							</StackPanel>
						</Grid>
					</StackPanel>

					<!-- Panel Toy -->
					<StackPanel Spacing="16"
                                IsVisible="{Binding MostrarToy}">
						<TextBlock Text="Detalles Toy"
                                   FontSize="16" FontWeight="SemiBold"/>

						<Grid ColumnDefinitions="*,16,*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Edad mínima"/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding ToyEdadMinima}"
												   Minimum="0"
												   Increment="1"
												   FormatString="F0"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Jugadores mín."/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding ToyJugadoresMin}"
												   Minimum="1"
												   Increment="1"
												   FormatString="F0"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="4" Spacing="4">
								<TextBlock Text="Jugadores máx."/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding ToyJugadoresMax}"
												   Minimum="1"
												   Increment="1"
												   FormatString="F0"/>
								</DataValidationErrors>
							</StackPanel>
						</Grid>

						<CheckBox Content="Es juego de mesa"
                                  IsChecked="{Binding ToyEsJuegoMesa}"/>
					</StackPanel>

					<!-- Panel Varios -->
					<StackPanel Spacing="16"
                                IsVisible="{Binding MostrarVarios}">
						<TextBlock Text="Detalles Varios"
                                   FontSize="16" FontWeight="SemiBold"/>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Marca"/>
								<DataValidationErrors>
									<TextBox Text="{Binding VariosMarca, UpdateSourceTrigger=PropertyChanged}"
											 Watermark="Ej: LEGO"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Material"/>
								<DataValidationErrors>
									<TextBox Text="{Binding VariosMaterial}"
											 Watermark="Ej: Plástico"/>
								</DataValidationErrors>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="*,16,*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Alto (cm)"/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding VariosAlto}"
												   Minimum="0"
												   FormatString="F2"
												   Increment="0.5"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Ancho (cm)"/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding VariosAncho}"
												   Minimum="0"
												   FormatString="F2"
												   Increment="0.5"/>
								</DataValidationErrors>
							</StackPanel>

							<StackPanel Grid.Column="4" Spacing="4">
								<TextBlock Text="Largo (cm) - opcional"/>
								<DataValidationErrors>
									<NumericUpDown Value="{Binding VariosLargo}"
												   Minimum="0"
												   FormatString="F2"
												   Increment="0.5"/>
								</DataValidationErrors>
							</StackPanel>
						</Grid>

						<CheckBox Content="Tiene ilustración"
                                  IsChecked="{Binding VariosTieneIlustracion}"/>
					</StackPanel>

				</StackPanel>
			</Border>
		</ScrollViewer>

		<!-- Footer -->
		<Border Grid.Row="2" Margin="16,0,16,16" Background="{DynamicResource TeejoshSurfaceBrush}" Padding="16">
			<Grid ColumnDefinitions="*,Auto,8,Auto">
				<Button Grid.Column="1"
                        Command="{Binding GuardarCommand}"
                        Content="Crear Producto"
                        Background="#FF9800"
                        Foreground="White"
                        Height="40" Padding="24,0"/>

				<Button Grid.Column="3"
                        Command="{Binding VolverCommand}"
                        Content="Cancelar"
                        Height="40" Padding="24,0"/>
			</Grid>
		</Border>

		<!-- Loading Overlay -->
		<Border Grid.RowSpan="3"
                Background="#CC000000"
                IsVisible="{Binding IsBusy}">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<ProgressBar IsIndeterminate="True"
                             Width="64" Height="64"
                             Margin="0,0,0,16"/>
				<TextBlock Text="Guardando..."
                           FontSize="16" Foreground="White"
                           HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
