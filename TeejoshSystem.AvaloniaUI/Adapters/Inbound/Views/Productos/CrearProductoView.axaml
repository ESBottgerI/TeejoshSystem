<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
			 x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.CrearProductoView"
			 x:CompileBindings="False">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Header -->
		<Border Grid.Row="0" Background="{DynamicResource TeejoshPrimaryBrush}" Padding="24,16">
			<TextBlock Text="Crear Producto"
					   FontSize="20" FontWeight="SemiBold"
					   Foreground="White" VerticalAlignment="Center"/>
		</Border>

		<!-- Formulario -->
		<ScrollViewer Grid.Row="1" Margin="16">
			<Border Theme="{StaticResource ContentPanel}">
				<StackPanel Margin="24" Spacing="16">

					<!-- Datos comunes -->
					<TextBlock Text="Datos Generales"
							   Theme="{StaticResource SectionTitle}"/>

					<StackPanel Spacing="4">
						<TextBlock Text="Tipo de producto" Theme="{StaticResource FieldLabel}"/>
						<ComboBox ItemsSource="{Binding TiposDisponibles}"
								  SelectedItem="{Binding TipoSeleccionado}"
								  DisplayMemberBinding="{Binding Nombre}"
								  HorizontalAlignment="Stretch"/>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="Nombre" Theme="{StaticResource FieldLabel}"/>
						<TextBox Text="{Binding Nombre}"
								 Watermark="Nombre del producto"/>
					</StackPanel>

					<Grid ColumnDefinitions="*,16,*">
						<StackPanel Grid.Column="0" Spacing="4">
							<TextBlock Text="Precio" Theme="{StaticResource FieldLabel}"/>
							<NumericUpDown Value="{Binding Precio}"
										   Minimum="0"
										   FormatString="F2"
										   Increment="0.5"/>
						</StackPanel>

						<StackPanel Grid.Column="2" Spacing="4">
							<TextBlock Text="Unidades" Theme="{StaticResource FieldLabel}"/>
							<NumericUpDown Value="{Binding Unidades}"
										   Minimum="0"
										   Increment="1"
										   FormatString="F0"/>
						</StackPanel>
					</Grid>

					<Border Background="{DynamicResource TeejoshSurfaceBrush}" CornerRadius="4" Padding="12" Margin="0,8,0,0">
						<StackPanel Spacing="8">
							<TextBlock Text="Imagen del producto" FontWeight="SemiBold" FontSize="13"/>

							<!-- Sin imagen seleccionada -->
							<Button Command="{Binding SeleccionarImagenCommand}"
									IsVisible="{Binding ImageNombre, Converter={x:Static ObjectConverters.IsNull}}"
									Content="📁 Seleccionar imagen"
									HorizontalAlignment="Left"/>

							<!-- Con imagen seleccionada -->
							<StackPanel Orientation="Horizontal" Spacing="8"
										IsVisible="{Binding ImageNombre, Converter={x:Static ObjectConverters.IsNotNull}}">
								<TextBlock Text="✓" Foreground="{DynamicResource TeejoshSuccessBrush}" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding ImageNombre}" VerticalAlignment="Center"/>
								<Button Content="Quitar"
										Command="{Binding QuitarImagenCommand}"
										Background="Transparent"
										Foreground="{DynamicResource TeejoshDangerBrush}"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- Panel Hot Wheels -->
					<StackPanel Spacing="16"
								IsVisible="{Binding MostrarHotWheels}">
						<TextBlock Text="Detalles Hot Wheels"
								   Theme="{StaticResource SectionTitle}"/>

						<StackPanel Spacing="4">
							<TextBlock Text="Modelo" Theme="{StaticResource FieldLabel}"/>
							<TextBox Text="{Binding HwModelo}"
									 Watermark="Ej: Ford Mustang"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Año" Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding HwAnio}"
											   Minimum="1967"
											   Increment="1"
											   FormatString="F0"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Serie" Theme="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding HwSerie}"
										 Watermark="Ej: HW Race Team"/>
							</StackPanel>
						</Grid>

						<StackPanel Spacing="4">
							<TextBlock Text="Categoría" Theme="{StaticResource FieldLabel}"/>
							<ComboBox ItemsSource="{Binding CategoriasHotWheels}"
									  SelectedItem="{Binding HwCategoriaSeleccionada}"
									  DisplayMemberBinding="{Binding Nombre}"
									  HorizontalAlignment="Stretch"/>
						</StackPanel>
					</StackPanel>

					<!-- Panel Funko -->
					<StackPanel Spacing="16"
								IsVisible="{Binding MostrarFunko}">
						<TextBlock Text="Detalles Funko"
								   Theme="{StaticResource SectionTitle}"/>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Número de caja" Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding FunkoNumeroBox}"
											   Minimum="0"
											   Increment="1"
											   FormatString="F0"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Licencia" Theme="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding FunkoLicencia}"
										 Watermark="Ej: Marvel"/>
							</StackPanel>
						</Grid>

						<StackPanel Spacing="4">
							<TextBlock Text="Subtipo" Theme="{StaticResource FieldLabel}"/>
							<ComboBox ItemsSource="{Binding SubtiposFunko}"
									  SelectedItem="{Binding FunkoSubtipoSeleccionado}"
									  DisplayMemberBinding="{Binding Nombre}"
									  HorizontalAlignment="Stretch"/>
						</StackPanel>

						<StackPanel Spacing="4">
							<TextBlock Text="Característica especial (opcional)" Theme="{StaticResource FieldLabel}"/>
							<ComboBox ItemsSource="{Binding CaracteristicasFunko}"
									  SelectedItem="{Binding FunkoCaracteristicaSeleccionada}"
									  DisplayMemberBinding="{Binding Nombre}"
									  HorizontalAlignment="Stretch"/>
						</StackPanel>
					</StackPanel>

					<!-- Panel TCG -->
					<StackPanel Spacing="16"
								IsVisible="{Binding MostrarTcg}">
						<TextBlock Text="Detalles TCG"
								   Theme="{StaticResource SectionTitle}"/>

						<StackPanel Spacing="4">
							<TextBlock Text="Franquicia" Theme="{StaticResource FieldLabel}"/>
							<ComboBox ItemsSource="{Binding FranquiciasTcg}"
									  SelectedItem="{Binding TcgFranquiciaSeleccionada}"
									  DisplayMemberBinding="{Binding Nombre}"
									  HorizontalAlignment="Stretch"/>
							<Button Content="Cargar expansiones y packs"
									Command="{Binding ActualizarFranquiciaTcgCommand}"
									HorizontalAlignment="Left"/>
						</StackPanel>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Expansión" Theme="{StaticResource FieldLabel}"/>
								<ComboBox ItemsSource="{Binding TcgExpansionesDisponibles}"
										  SelectedItem="{Binding TcgExpansionSeleccionada}"
										  DisplayMemberBinding="{Binding Nombre}"
										  HorizontalAlignment="Stretch"/>
								<Button Content="Usar imagen de la expansión"
										Command="{Binding UsarImagenExpansionCommand}"
										HorizontalAlignment="Left"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Pack" Theme="{StaticResource FieldLabel}"/>
								<ComboBox ItemsSource="{Binding TcgPacksDisponibles}"
										  SelectedItem="{Binding TcgPackSeleccionado}"
										  DisplayMemberBinding="{Binding Nombre}"
										  HorizontalAlignment="Stretch"/>
							</StackPanel>
						</Grid>
					</StackPanel>

					<!-- Panel Toy -->
					<StackPanel Spacing="16"
								IsVisible="{Binding MostrarToy}">
						<TextBlock Text="Detalles Toy"
								   Theme="{StaticResource SectionTitle}"/>

						<Grid ColumnDefinitions="*,16,*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Edad mínima" Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding ToyEdadMinima}"
											   Minimum="0"
											   Increment="1"
											   FormatString="F0"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Jugadores mín." Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding ToyJugadoresMin}"
											   Minimum="1"
											   Increment="1"
											   FormatString="F0"/>
							</StackPanel>

							<StackPanel Grid.Column="4" Spacing="4">
								<TextBlock Text="Jugadores máx." Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding ToyJugadoresMax}"
											   Minimum="1"
											   Increment="1"
											   FormatString="F0"/>
							</StackPanel>
						</Grid>

						<CheckBox Content="Es juego de mesa"
								  IsChecked="{Binding ToyEsJuegoMesa}"/>
					</StackPanel>

					<!-- Panel Varios -->
					<StackPanel Spacing="16"
								IsVisible="{Binding MostrarVarios}">
						<TextBlock Text="Detalles Varios"
								   Theme="{StaticResource SectionTitle}"/>

						<Grid ColumnDefinitions="*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Marca" Theme="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding VariosMarca}"
										 Watermark="Ej: LEGO"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Material" Theme="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding VariosMaterial}"
										 Watermark="Ej: Plástico"/>
							</StackPanel>
						</Grid>

						<Grid ColumnDefinitions="*,16,*,16,*">
							<StackPanel Grid.Column="0" Spacing="4">
								<TextBlock Text="Alto (cm)" Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding VariosAlto}"
											   Minimum="0"
											   FormatString="F2"
											   Increment="0.5"/>
							</StackPanel>

							<StackPanel Grid.Column="2" Spacing="4">
								<TextBlock Text="Ancho (cm)" Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding VariosAncho}"
											   Minimum="0"
											   FormatString="F2"
											   Increment="0.5"/>
							</StackPanel>

							<StackPanel Grid.Column="4" Spacing="4">
								<TextBlock Text="Largo (cm) - opcional" Theme="{StaticResource FieldLabel}"/>
								<NumericUpDown Value="{Binding VariosLargo}"
											   Minimum="0"
											   FormatString="F2"
											   Increment="0.5"/>
							</StackPanel>
						</Grid>

						<CheckBox Content="Tiene ilustración"
								  IsChecked="{Binding VariosTieneIlustracion}"/>
					</StackPanel>

				</StackPanel>
			</Border>
		</ScrollViewer>

		<!-- Footer -->
		<Border Grid.Row="2"
				Margin="16,0,16,16"
				Theme="{StaticResource FooterPanel}">
			<Grid ColumnDefinitions="*,Auto,8,Auto">
				<Button Grid.Column="1"
						Command="{Binding GuardarCommand}"
						Theme="{StaticResource BrandButton}"
						Content="Crear Producto"/>

				<Button Grid.Column="3"
						Command="{Binding VolverCommand}"
						Theme="{StaticResource StandardButton}"
						Content="Cancelar"/>
			</Grid>
		</Border>

		<!-- Loading Overlay -->
		<Border Grid.RowSpan="3"
				Theme="{StaticResource LoadingOverlay}"
				IsVisible="{Binding IsBusy}">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<ProgressBar IsIndeterminate="True"
							 Width="64" Height="64"
							 Margin="0,0,0,16"/>
				<TextBlock Text="Guardando..."
						   FontSize="16" Foreground="White"
						   HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
