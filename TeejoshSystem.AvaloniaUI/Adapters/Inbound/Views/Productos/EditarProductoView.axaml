<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.EditarProductoView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource TeejoshPrimaryBrush}" Padding="24,16">
            <TextBlock Text="Editar Producto"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1" Margin="16" Theme="{StaticResource ContentPanel}">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Text="Datos del Producto"
                           Theme="{StaticResource SectionTitle}"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Nombre" Theme="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Nombre}"
                             Watermark="Nombre del producto"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Precio" Theme="{StaticResource FieldLabel}"/>
                    <NumericUpDown Value="{Binding Precio}"
                                   Minimum="0"
                                   FormatString="F2"
                                   Increment="0.5"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Unidades en stock" Theme="{StaticResource FieldLabel}"/>
                    <NumericUpDown Value="{Binding Unidades}"
                                   Minimum="0"
                                   Increment="1"
                                   FormatString="F0"/>
                </StackPanel>

                <!-- Selector de imagen -->
                <Border Background="{DynamicResource TeejoshSurfaceBrush}" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Imagen del producto" FontWeight="SemiBold" FontSize="13"/>

                        <!-- Sin imagen seleccionada -->
                        <Button Command="{Binding SeleccionarImagenCommand}"
                                IsVisible="{Binding ImageNombre, Converter={x:Static ObjectConverters.IsNull}}"
                                Content="📁 Seleccionar imagen"
                                HorizontalAlignment="Left"/>

                        <!-- Con imagen seleccionada -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding ImageNombre, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="✓" Foreground="{DynamicResource TeejoshSuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ImageNombre}" VerticalAlignment="Center"/>
                            <Button Content="Quitar"
                                    Command="{Binding QuitarImagenCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TeejoshDangerBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="16,0,16,16"
                Theme="{StaticResource FooterPanel}">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <Button Grid.Column="1"
                        Command="{Binding GuardarCommand}"
                        Theme="{StaticResource BrandButton}"
                        Content="Guardar"/>

                <Button Grid.Column="3"
                        Command="{Binding VolverCommand}"
                        Theme="{StaticResource StandardButton}"
                        Content="Cancelar"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Theme="{StaticResource LoadingOverlay}"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="64" Height="64"
                             Margin="0,0,0,16"/>
                <TextBlock Text="Guardando..."
                           FontSize="16" Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
