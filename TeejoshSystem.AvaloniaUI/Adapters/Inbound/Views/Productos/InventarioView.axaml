<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             xmlns:converters="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Converters"
             xmlns:busqueda="clr-namespace:TeejoshSystem.Application.Ports.Inbound.Productos.Queries.BuscarProductos;assembly=TeejoshSystem.Application"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.InventarioView"
             x:CompileBindings="False">

    <!-- NUEVO: Resources con el converter -->
    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImage"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource TeejoshPrimaryBrush}"
                Padding="24,16">
            <TextBlock Text="Inventario"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Contenido -->
        <Border Grid.Row="1"
                Margin="16"
                Theme="{StaticResource ContentPanel}">
            <Grid RowDefinitions="Auto,*">

                <!-- Filtros -->
                <StackPanel Grid.Row="0" Margin="24,24,24,16">
                    <TextBlock Text="Búsqueda y Filtros"
                               Theme="{StaticResource SectionTitle}"
                               Margin="0,0,0,16"/>
                    <Grid ColumnDefinitions="*,16,200,16,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda}"
                                 Watermark="Buscar por nombre..."/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoFiltro}"
                                  DisplayMemberBinding="{Binding Nombre}"
                                  PlaceholderText="Tipo de producto"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding CargarCommand}"
                                    Theme="{StaticResource BrandButton}"
                                    Content="Buscar"/>
                            <Button Command="{Binding AlternarStockGlobalCommand}"
                                    Content="Alternar todo el stock"
                                    AutomationProperties.Name="Alternar visibilidad de todo el stock"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding MensajeError}"
                           Foreground="{DynamicResource TeejoshErrorTextBrush}"
                           IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Margin="24,0"/>

                <!-- DataGrid -->
                <!-- CAMBIO: AutoGenerateColumns="False" para controlar columnas manualmente -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Productos}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="24,0,24,24">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Nombre" Width="2*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="32,*" Margin="2" ToolTip.Tip="{Binding Nombre}">
                                        <Image Source="{Binding ImageThumbnail, Converter={StaticResource BytesToImageConverter}}"
                                               Width="28" Height="28" Stretch="Uniform"
                                               IsVisible="{Binding ImageThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <Border Background="{DynamicResource TeejoshBorderBrush}" CornerRadius="4"
                                                Width="28" Height="28"
                                                IsVisible="{Binding ImageThumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="□" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Columnas originales — sin cambios -->
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Precio"
                                            Binding="{Binding Precio, Converter={StaticResource SolesConverter}}"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="Stock" Width="110" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding StockTexto}"
                                            Command="{Binding $parent[UserControl].DataContext.AlternarStockFilaCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Alternar visibilidad del stock de esta fila"
                                            HorizontalAlignment="Stretch"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Detalle"
                                            Binding="{Binding DetalleResumen}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="16,0,16,16"
                Theme="{StaticResource FooterPanel}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Total de productos: "/>
                    <Run Text="{Binding Productos.Count, Mode=OneWay}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TeejoshPrimaryBrush}"/>
                </TextBlock>

                <Button Grid.Column="1"
                        Command="{Binding VolverCommand}"
                        Theme="{StaticResource StandardButton}"
                        Content="Volver"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Theme="{StaticResource LoadingOverlay}"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="64"
                             Height="64"
                             Margin="0,0,0,16"/>
                <TextBlock Text="Cargando inventario..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
