<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Ventas"
			 x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Ventas.HistorialVentasView"
			 x:DataType="vm:HistorialVentasViewModel"
			 x:CompileBindings="False">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Header -->
		<Border Grid.Row="0" Background="{DynamicResource TeejoshInfoBrush}" Padding="24,16">
			<TextBlock Text="Historial de Ventas"
					   FontSize="20" FontWeight="SemiBold"
					   Foreground="White" VerticalAlignment="Center"/>
		</Border>

		<!-- Contenido -->
		<Border Grid.Row="1" Margin="16" Theme="{StaticResource ContentPanel}">
			<Grid RowDefinitions="Auto,*,Auto">

				<!-- Filtros de fecha -->
				<StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="12">
					<TextBlock Text="Filtrar por fecha"
							   Theme="{StaticResource SectionTitle}"/>
					<Grid ColumnDefinitions="Auto,8,*,16,Auto,8,*,16,Auto,8,Auto">
						<TextBlock Grid.Column="0" Text="Desde:"
								   VerticalAlignment="Center"/>
						<CalendarDatePicker Grid.Column="2"
											SelectedDate="{Binding FechaDesde}"/>

						<TextBlock Grid.Column="4" Text="Hasta:"
								   VerticalAlignment="Center"/>
						<CalendarDatePicker Grid.Column="6"
											SelectedDate="{Binding FechaHasta}"/>

						<Button Grid.Column="8"
								Command="{Binding BuscarCommand}"
								Content="Filtrar"
								Theme="{StaticResource StandardButton}"
								Background="{DynamicResource TeejoshInfoBrush}"
								Foreground="White"/>
						<Button Grid.Column="10"
								Command="{Binding LimpiarFiltrosCommand}"
								Theme="{StaticResource StandardButton}"
								Content="Limpiar"/>
					</Grid>
				</StackPanel>

				<!-- Lista de ventas -->
				<DataGrid Grid.Row="1"
						  ItemsSource="{Binding Ventas}"
						  SelectedItem="{Binding VentaSeleccionada}"
						  SelectionMode="Single"
						  AutoGenerateColumns="False"
						  IsReadOnly="True"
						  Margin="24,0,24,0">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID"
											Binding="{Binding Id}"
											Width="60"/>
						<DataGridTextColumn Header="Fecha"
											Binding="{Binding Fecha, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"
											Width="160"/>
						<DataGridTextColumn Header="Productos"
											Binding="{Binding Detalles.Count}"
											Width="90"/>
						<DataGridTextColumn Header="Total"
											Binding="{Binding Total, Converter={StaticResource SolesConverter}}"
											Width="120"/>
					</DataGrid.Columns>
				</DataGrid>

				<!-- Detalle de venta seleccionada -->
				<Border Grid.Row="2"
						Margin="24,12,24,24"
						IsVisible="{Binding VentaSeleccionada, Converter={x:Static ObjectConverters.IsNotNull}}">
					<StackPanel Spacing="8">
						<TextBlock Text="Detalle de la venta seleccionada"
								   FontWeight="SemiBold"/>
						<DataGrid ItemsSource="{Binding VentaSeleccionada.Detalles}"
								  AutoGenerateColumns="False"
								  IsReadOnly="True"
								  MaxHeight="180">
							<DataGrid.Columns>
								<DataGridTemplateColumn Header="Producto" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NombreProducto}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NombreProducto}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
								<DataGridTextColumn Header="Cant."
													Binding="{Binding Cantidad}"
													Width="60"/>
								<DataGridTextColumn Header="P.Unit."
													Binding="{Binding PrecioUnitario, Converter={StaticResource SolesConverter}}"
													Width="100"/>
								<DataGridTextColumn Header="Subtotal"
													Binding="{Binding Subtotal, Converter={StaticResource SolesConverter}}"
													Width="100"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2" Margin="16,0,16,16" Theme="{StaticResource FooterPanel}">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock VerticalAlignment="Center">
					<Run Text="Total ventas: "/>
					<Run Text="{Binding Ventas.Count, Mode=OneWay}"
						 FontWeight="Bold" Foreground="{DynamicResource TeejoshInfoBrush}"/>
				</TextBlock>
				<Button Grid.Column="1"
						Command="{Binding VolverCommand}"
						Theme="{StaticResource StandardButton}"
						Content="Volver"/>
			</Grid>
		</Border>

		<!-- Loading Overlay -->
		<Border Grid.RowSpan="3"
				Theme="{StaticResource LoadingOverlay}"
				IsVisible="{Binding IsBusy}">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<ProgressBar IsIndeterminate="True"
							 Width="64" Height="64"
							 Margin="0,0,0,16"/>
				<TextBlock Text="Cargando historial..."
						   FontSize="16" Foreground="White"
						   HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
