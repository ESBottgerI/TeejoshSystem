<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmMenu="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Menu"
             xmlns:vmProductos="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             xmlns:viewsMenu="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Menu"
             xmlns:viewsProductos="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos"
             xmlns:vmVentas="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Ventas"
			 xmlns:viewsVentas="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Ventas"
             xmlns:helpers="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Helpers"
			 x:Class="TeejoshSystem.AvaloniaUI.App">
	
	<Application.RequestedThemeVariant>Light</Application.RequestedThemeVariant>

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="TeejoshSurfaceBrush">White</SolidColorBrush>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="TeejoshSurfaceBrush">#1e1e1e</SolidColorBrush>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

		<!-- REFINAMIENTO DE UX Y ESTÉTICA -->
		<Style Selector="TextBox">
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="10,0,6,0" />
			<Setter Property="MinHeight" Value="32" />
			<Setter Property="Template">
				<ControlTemplate>
					<StackPanel Spacing="0" ClipToBounds="False">
						<Border Name="PART_BorderElement"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{TemplateBinding CornerRadius}"
								MinHeight="{TemplateBinding MinHeight}"
								VerticalAlignment="Center">
							<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
								<ContentPresenter Grid.Column="0" 
												  Content="{TemplateBinding InnerLeftContent}"
												  VerticalAlignment="Center"/>
								<ScrollViewer Grid.Column="1"
											  VerticalAlignment="Center"
											  Padding="{TemplateBinding Padding}"
											  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
											  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
									<TextPresenter Name="PART_TextPresenter"
												   Text="{TemplateBinding Text, Mode=TwoWay}"
												   CaretIndex="{TemplateBinding CaretIndex}"
												   SelectionStart="{TemplateBinding SelectionStart}"
												   SelectionEnd="{TemplateBinding SelectionEnd}"
												   TextAlignment="{TemplateBinding TextAlignment}"
												   TextWrapping="{TemplateBinding TextWrapping}"
												   PasswordChar="{TemplateBinding PasswordChar}"
												   RevealPassword="{TemplateBinding RevealPassword}"
												   SelectionBrush="{TemplateBinding SelectionBrush}"
												   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
												   CaretBrush="{TemplateBinding CaretBrush}"
												   LineHeight="{TemplateBinding LineHeight}"
												   VerticalAlignment="Center"/>
								</ScrollViewer>
								<ContentPresenter Grid.Column="2" 
												  Content="{TemplateBinding InnerRightContent}"
												  VerticalAlignment="Center"/>
							</Grid>
						</Border>

						<!-- El mensaje de error inyectado: Solo si el campo ha sido tocado (enfocado) -->
						<ItemsControl ItemsSource="{TemplateBinding (DataValidationErrors.Errors)}"
									  IsVisible="{Binding (helpers:ControlExtensions.IsTouched), RelativeSource={RelativeSource TemplatedParent}}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" 
											   Foreground="Red" 
											   FontSize="10.5" 
											   FontWeight="Normal"
											   TextWrapping="Wrap"
											   Margin="0,2,0,0"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</ControlTemplate>
			</Setter>
		</Style>

		<!-- Bloqueo de selección por scroll en ComboBox -->
		<Style Selector="ComboBox">
			<Setter Property="helpers:ControlExtensions.BlockScroll" Value="True" />
		</Style>

		<!-- Lógica de Texto Rojo en Error (Solo cuando NO tiene el foco y HA SIDO TOCADO) -->
		<Style Selector="TextBox:error[(helpers|ControlExtensions.IsTouched)=True]:not(:focus)">
			<Setter Property="Foreground" Value="Red" />
		</Style>
		
		<Style Selector="NumericUpDown:error[(helpers|ControlExtensions.IsTouched)=True]:not(:focus) /template/ TextBox">
			<Setter Property="Foreground" Value="Red" />
		</Style>

		<!-- Borde rojo para controles con error (Solo si HA SIDO TOCADO) -->
		<Style Selector="TextBox:error[(helpers|ControlExtensions.IsTouched)=True] /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="Red" />
			<Setter Property="BorderThickness" Value="1.2" />
		</Style>

		<!-- Forzamos el borde normal si NO ha sido tocado, anulando el tema Fluent -->
		<Style Selector="TextBox:error[(helpers|ControlExtensions.IsTouched)=False] /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
		</Style>

		<Style Selector="NumericUpDown:error[(helpers|ControlExtensions.IsTouched)=True] /template/ TextBox">
			<Setter Property="BorderBrush" Value="Red" />
		</Style>

		<Style Selector="NumericUpDown:error[(helpers|ControlExtensions.IsTouched)=False] /template/ TextBox">
			<Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
		</Style>
	</Application.Styles>

	<Application.DataTemplates>
		<DataTemplate DataType="{x:Type vmMenu:MenuPrincipalViewModel}">
			<viewsMenu:MenuPrincipalView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vmProductos:InventarioViewModel}">
			<viewsProductos:InventarioView />
		</DataTemplate>
        <DataTemplate DataType="{x:Type vmProductos:GestionarProductosViewModel}">
            <viewsProductos:GestionarProductosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProductos:CrearProductoViewModel}">
            <viewsProductos:CrearProductoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProductos:EditarProductoViewModel}">
            <viewsProductos:EditarProductoView />
        </DataTemplate>
		<DataTemplate DataType="{x:Type vmVentas:RegistrarVentaViewModel}">
			<viewsVentas:RegistrarVentaView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vmVentas:HistorialVentasViewModel}">
			<viewsVentas:HistorialVentasView />
		</DataTemplate>
	</Application.DataTemplates>
</Application>