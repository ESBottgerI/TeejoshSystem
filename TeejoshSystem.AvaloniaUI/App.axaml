<!-- dotnet ef database update __project TeejoshSystem.Infrastructure __startup-project TeejoshSystem.AvaloniaUI -->

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmMenu="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Menu"
             xmlns:vmProductos="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             xmlns:viewsMenu="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Menu"
             xmlns:viewsProductos="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.App">
	
	<Application.RequestedThemeVariant>Light</Application.RequestedThemeVariant>
	<Application.Styles>
		<FluentTheme />
	</Application.Styles>

	<Application.DataTemplates>
		<DataTemplate DataType="{x:Type vmMenu:MenuPrincipalViewModel}">
			<viewsMenu:MenuPrincipalView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type vmProductos:InventarioViewModel}">
			<viewsProductos:InventarioView />
		</DataTemplate>
        <DataTemplate DataType="{x:Type vmProductos:GestionarProductosViewModel}">
            <viewsProductos:GestionarProductosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProductos:CrearProductoViewModel}">
            <viewsProductos:CrearProductoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmProductos:EditarProductoViewModel}">
            <viewsProductos:EditarProductoView />
        </DataTemplate>
	</Application.DataTemplates>
</Application>