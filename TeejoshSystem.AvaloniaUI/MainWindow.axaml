<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TeejoshSystem.AvaloniaUI.MainWindow"
        Title="TeejoshSystem - Inventario"
        Width="1024"
        Height="768"
        WindowStartupLocation="CenterScreen"
		x:CompileBindings="False">

	<Grid RowDefinitions="Auto,*">
        
        <!-- Barra de título -->
        <Border Grid.Row="0" Background="#2C3E50" Height="50">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TeejoshSystem - Gestion de Inventario"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" Spacing="10">
                    <TextBlock Text="Tema:" Foreground="White" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedThemeOption}"
                              VerticalAlignment="Center"
                              Width="120">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Contenido dinámico -->
		<ContentControl Grid.Row="1"
						Content="{Binding CurrentView}" />
    </Grid>
</Window>