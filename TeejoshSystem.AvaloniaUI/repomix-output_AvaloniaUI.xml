<file path="Adapters/Inbound/Views/Catalogos/SincronizarCatalogosView.axaml">
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Catalogos.SincronizarCatalogosView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Background="#FF9800" Padding="24,16">
            <TextBlock Text="Sincronizar Catálogos"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="{DynamicResource TeejoshSurfaceBrush}" CornerRadius="4">
            <StackPanel Margin="24" Spacing="16">

                <TextBlock Text="Sincronización de catálogos TCG"
                           FontSize="16" FontWeight="SemiBold"/>

                <TextBlock TextWrapping="Wrap" Foreground="#666666">
                    Conecta con TCGdex (Pokémon), Scryfall (Magic) y YGOProDeck (Yu-Gi-Oh!)
                    para actualizar las expansiones disponibles.
                    One Piece y Bluey se gestionan manualmente.
                </TextBlock>

                <!-- Resultado -->
                <Border Background="#F5F5F5" CornerRadius="4" Padding="16"
                        IsVisible="{Binding Resultado,
                            Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Resultado:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Resultado}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Loading -->
                <StackPanel Orientation="Horizontal" Spacing="12"
                            IsVisible="{Binding IsBusy}">
                    <ProgressBar IsIndeterminate="True" Width="24" Height="24"/>
                    <TextBlock Text="Sincronizando expansiones..."
                               VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="16,0,16,16" Background="{DynamicResource TeejoshSurfaceBrush}" Padding="16">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <Button Grid.Column="1"
                        Command="{Binding SincronizarCommand}"
                        Content="Sincronizar ahora"
                        Background="#FF9800"
                        Foreground="White"
                        Height="40" Padding="24,0"
                        IsEnabled="{Binding IsBusy,
                            Converter={x:Static BoolConverters.Not}}"/>

                <Button Grid.Column="3"
                        Command="{Binding VolverCommand}"
                        Content="Volver"
                        Height="40" Padding="24,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
</file>

