<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.GestionarProductosView"
             x:DataType="vm:GestionarProductosViewModel"
			 x:CompileBindings="False">

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Header -->
		<Border Grid.Row="0" Background="#FF9800" Padding="24,16">
			<TextBlock Text="Gestionar Productos"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>
		</Border>

		<!-- Contenido -->
		<Border Grid.Row="1" Margin="16" Background="{DynamicResource TeejoshSurfaceBrush}" CornerRadius="4">
			<Grid RowDefinitions="Auto,*">

				<!-- Filtros -->
				<StackPanel Grid.Row="0" Margin="24,24,24,16">
					<TextBlock Text="Búsqueda y Filtros"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,16"/>
					<Grid ColumnDefinitions="*,16,200,16,Auto">
						<TextBox Grid.Column="0"
                                 Text="{Binding TextoBusqueda}"
                                 Watermark="Buscar por nombre..."/>

						<ComboBox Grid.Column="2"
                                  ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoFiltro}"
                                  DisplayMemberBinding="{Binding Nombre}"
                                  PlaceholderText="Tipo de producto"/>

						<Button Grid.Column="4"
                                Command="{Binding BuscarCommand}"
                                Background="#FF9800"
                                Foreground="White"
                                Content="Buscar"
                                Height="40"
                                Padding="24,0"/>
					</Grid>
				</StackPanel>

				<!-- DataGrid -->
				<DataGrid Grid.Row="1"
                          ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding ProductoSeleccionado}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="24,0,24,24">
					<DataGrid.Columns>
						<DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="60"/>
						<DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="2*"/>
						<DataGridTextColumn Header="Precio"
                                            Binding="{Binding Precio, StringFormat=\{0:C\}}"
                                            Width="100"/>
						<DataGridTextColumn Header="Stock"
                                            Binding="{Binding Unidades}"
                                            Width="80"/>
						<DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="120"/>
						<DataGridTextColumn Header="Detalle"
                                            Binding="{Binding DetalleResumen}"
                                            Width="2*"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</Border>

		<!-- Footer -->
		<Border Grid.Row="2" Margin="16,0,16,16" Background="{DynamicResource TeejoshSurfaceBrush}" Padding="16">
			<Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
				<TextBlock VerticalAlignment="Center">
					<Run Text="Total: "/>
					<Run Text="{Binding Productos.Count, Mode=OneWay}"
                         FontWeight="Bold" Foreground="#FF9800"/>
					<Run Text=" productos"/>
				</TextBlock>

				<Button Grid.Column="1"
                        Command="{Binding EditarCommand}"
                        Content="Editar"
                        Height="40" Padding="24,0"/>

				<Button Grid.Column="3"
                        Command="{Binding EliminarCommand}"
                        Content="Eliminar"
                        Background="#E53935"
                        Foreground="White"
                        Height="40" Padding="24,0"/>

				<Button Grid.Column="5"
                        Command="{Binding VolverCommand}"
                        Content="Volver"
                        Height="40" Padding="24,0"/>
			</Grid>
		</Border>

		<!-- Loading Overlay -->
		<Border Grid.RowSpan="3"
                Background="#CC000000"
                IsVisible="{Binding IsBusy}">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<ProgressBar IsIndeterminate="True"
                             Width="64" Height="64"
                             Margin="0,0,0,16"/>
				<TextBlock Text="Cargando..."
                           FontSize="16" Foreground="White"
                           HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
</file>

