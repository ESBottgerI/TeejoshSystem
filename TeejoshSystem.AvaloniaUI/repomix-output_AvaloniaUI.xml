<file path="Adapters/Inbound/Views/Productos/InventarioView.axaml">
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             xmlns:converters="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Converters"
             xmlns:busqueda="clr-namespace:TeejoshSystem.Application.Ports.Inbound.Productos.Queries.BuscarProductos;assembly=TeejoshSystem.Application"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.InventarioView"
             x:CompileBindings="False">

    <!-- NUEVO: Resources con el converter -->
    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImage"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FF9800"
                Padding="24,16">
            <TextBlock Text="Inventario"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Contenido -->
        <Border Grid.Row="1"
                Margin="16"
                Background="{DynamicResource TeejoshSurfaceBrush}"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,*">

                <!-- Filtros -->
                <StackPanel Grid.Row="0" Margin="24,24,24,16">
                    <TextBlock Text="Búsqueda y Filtros"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>
                    <Grid ColumnDefinitions="*,16,200,16,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda}"
                                 Watermark="Buscar por nombre..."/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoFiltro}"
                                  DisplayMemberBinding="{Binding Nombre}"
                                  PlaceholderText="Tipo de producto"/>

                        <Button Grid.Column="4"
                                Command="{Binding CargarCommand}"
                                Background="#FF9800"
                                Foreground="White"
                                Content="Buscar"
                                Height="40"
                                Padding="24,0"/>
                    </Grid>
                </StackPanel>

                <!-- DataGrid -->
                <!-- CAMBIO: AutoGenerateColumns="False" para controlar columnas manualmente -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Productos}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="24,0,24,24">
                    <DataGrid.Columns>

                        <!-- NUEVA columna de imagen -->
                        <DataGridTemplateColumn Header="Imagen" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Panel Width="50" Height="50" Margin="4">
                                        <!-- Imagen real si existe -->
                                        <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                               Width="50" Height="50"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding ImagePath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <!-- Placeholder si no existe -->
                                        <Border Background="#E0E0E0" CornerRadius="4"
                                                Width="50" Height="50"
                                                IsVisible="{Binding ImagePath, Converter={x:Static ObjectConverters.IsNull}}">
                                            <TextBlock Text="🖼" FontSize="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Columnas originales — sin cambios -->
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Precio"
                                            Binding="{Binding Precio, StringFormat=\{0:C\}}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding Unidades}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Detalle"
                                            Binding="{Binding DetalleResumen}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Margin="16,0,16,16"
                Background="{DynamicResource TeejoshSurfaceBrush}"
                Padding="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Total de productos: "/>
                    <Run Text="{Binding Productos.Count, Mode=OneWay}"
                         FontWeight="Bold"
                         Foreground="#FF9800"/>
                </TextBlock>

                <Button Grid.Column="1"
                        Command="{Binding VolverCommand}"
                        Content="Volver"
                        Height="40"
                        Padding="24,0"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Background="#CC000000"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="64"
                             Height="64"
                             Margin="0,0,0,16"/>
                <TextBlock Text="Cargando inventario..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
</file>

