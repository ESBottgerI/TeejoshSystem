@page "/cuenta/cambiar-password"
@attribute [Authorize(Roles = AuthorizationConstants.Administrador)]
@rendermode InteractiveServer
@using System.Security.Claims
@using MediatR
@using Microsoft.AspNetCore.Components.Authorization
@using TeejoshSystem.Application.Ports.Inbound.Auth.Commands.CambiarPassword
@inject IMediator Mediator
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Cambiar Contraseña</PageTitle>

<h3>Cambiar Contraseña</h3>

<EditForm Model="this" OnValidSubmit="GuardarAsync" style="max-width:420px;">
    <div class="mb-3">
        <label class="form-label">Contraseña actual</label>
        <input class="form-control" type="password" @bind="_passwordActual" />
    </div>
    <div class="mb-3">
        <label class="form-label">Contraseña nueva</label>
        <input class="form-control" type="password" @bind="_passwordNuevo" />
    </div>
    <div class="mb-3">
        <label class="form-label">Confirmar contraseña nueva</label>
        <input class="form-control" type="password" @bind="_passwordConfirmacion" />
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_mensajeExito is not null)
    {
        <div class="alert alert-success">@_mensajeExito</div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_guardando">
        @(_guardando ? "Guardando..." : "Cambiar contraseña")
    </button>
</EditForm>

@code {
    private string _passwordActual = string.Empty;
    private string _passwordNuevo = string.Empty;
    private string _passwordConfirmacion = string.Empty;
    private bool _guardando;
    private string? _error;
    private string? _mensajeExito;

    private async Task GuardarAsync()
    {
        _error = null;
        _mensajeExito = null;

        if (_passwordNuevo != _passwordConfirmacion)
        {
            _error = "La confirmación no coincide con la contraseña nueva.";
            return;
        }

        _guardando = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var usuarioIdTexto = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!int.TryParse(usuarioIdTexto, out var usuarioId))
            {
                _error = "No se pudo identificar la sesión actual. Vuelve a iniciar sesión.";
                return;
            }

            var resultado = await Mediator.Send(
                new CambiarPasswordCommand(usuarioId, _passwordActual, _passwordNuevo));

            if (resultado.IsSuccess)
            {
                _mensajeExito = "Contraseña actualizada correctamente.";
                _passwordActual = _passwordNuevo = _passwordConfirmacion = string.Empty;
            }
            else
            {
                _error = resultado.Error;
            }
        }
        catch (Exception ex)
        {
            _error = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }
}
