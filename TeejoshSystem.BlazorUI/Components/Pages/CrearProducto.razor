@page "/productos/crear"
@attribute [Authorize(Roles = AuthorizationConstants.Administrador)]
@rendermode InteractiveServer
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using TeejoshSystem.Application.Ports.Inbound.Productos.Commands.CrearProducto
@using TeejoshSystem.Application.Ports.Inbound.Catalogos.Queries.ObtenerCatalogos
@using TeejoshSystem.Application.Ports.Inbound.Catalogos.Queries.ObtenerExpansionesYPacks
@using TeejoshSystem.Domain.Enums
@using TeejoshSystem.BlazorUI.Services
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Añadir Producto</PageTitle>

<h3>Añadir Producto</h3>

@if (_cargandoCatalogos)
{
    <p><em>Cargando catálogos...</em></p>
}
else
{
    <EditForm Model="this" OnValidSubmit="GuardarAsync">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select class="form-select" @bind="_tipoSeleccionado">
                    @foreach (var tipo in Enum.GetValues<TipoProducto>())
                    {
                        <option value="@tipo">@TipoProductoDisplay.ToDisplayName(tipo)</option>
                    }
                </select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Nombre</label>
                <input class="form-control" @bind="_nombre" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Precio</label>
                <input class="form-control" type="number" step="0.01" @bind="_precio" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Unidades (stock inicial)</label>
                <input class="form-control" type="number" @bind="_unidades" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Imagen (opcional)</label>
                <InputFile class="form-control" OnChange="OnImagenSeleccionadaAsync" />
            </div>
        </div>

        <hr class="my-4" />

        @* ── Detalle específico por tipo ──────────────────────────────── *@
        @switch (_tipoSeleccionado)
        {
            case TipoProducto.Funko:
                <h5>Detalle Funko</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">N.º de Box</label>
                        <input class="form-control" type="number" @bind="_funkoNumeroBox" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Licencia</label>
                        <input class="form-control" @bind="_funkoLicencia" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Subtipo</label>
                        <select class="form-select" @bind="_funkoSubtipoId">
                            <option value="0">Seleccionar...</option>
                            @foreach (var item in _catalogos!.SubtiposFunko)
                            {
                                <option value="@item.Id">@item.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Característica especial (opcional)</label>
                        <select class="form-select" @bind="_funkoCaracteristicaId">
                            <option value="0">Ninguna</option>
                            @foreach (var item in _catalogos!.CaracteristicasFunko)
                            {
                                <option value="@item.Id">@item.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                break;

            case TipoProducto.HotWheels:
                <h5>Detalle Hot Wheels</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Modelo</label>
                        <input class="form-control" @bind="_hwModelo" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Año</label>
                        <input class="form-control" type="number" @bind="_hwAnio" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Serie</label>
                        <input class="form-control" @bind="_hwSerie" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Categoría</label>
                        <select class="form-select" @bind="_hwCategoriaId">
                            <option value="0">Seleccionar...</option>
                            @foreach (var item in _catalogos!.CategoriasHotWheels)
                            {
                                <option value="@item.Id">@item.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                break;

            case TipoProducto.Tcg:
                <h5>Detalle TCG</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Franquicia</label>
                        <select class="form-select" @bind="_tcgFranquiciaId" @bind:after="CargarExpansionesYPacksAsync">
                            <option value="0">Seleccionar...</option>
                            @foreach (var item in _catalogos!.FranquiciasTcg)
                            {
                                <option value="@item.Id">@item.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Expansión</label>
                        <select class="form-select" @bind="_tcgExpansionId" disabled="@(_expansionesYPacks is null)">
                            <option value="0">Seleccionar...</option>
                            @if (_expansionesYPacks is not null)
                            {
                                @foreach (var item in _expansionesYPacks.Expansiones)
                                {
                                    <option value="@item.Id">@item.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Pack</label>
                        <select class="form-select" @bind="_tcgPackId" disabled="@(_expansionesYPacks is null)">
                            <option value="0">Seleccionar...</option>
                            @if (_expansionesYPacks is not null)
                            {
                                @foreach (var item in _expansionesYPacks.Packs)
                                {
                                    <option value="@item.Id">@item.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                break;

            case TipoProducto.Toy:
                <h5>Detalle Juguete</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Edad mínima</label>
                        <input class="form-control" type="number" @bind="_toyEdadMinima" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Jugadores (mín.)</label>
                        <input class="form-control" type="number" @bind="_toyJugadoresMin" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Jugadores (máx.)</label>
                        <input class="form-control" type="number" @bind="_toyJugadoresMax" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="_toyEsJuegoMesa" id="esJuegoMesa" />
                            <label class="form-check-label" for="esJuegoMesa">¿Es juego de mesa?</label>
                        </div>
                    </div>
                </div>
                break;

            case TipoProducto.Varios:
                <h5>Detalle Varios</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Marca</label>
                        <input class="form-control" @bind="_variosMarca" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Material</label>
                        <input class="form-control" @bind="_variosMaterial" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Alto</label>
                        <input class="form-control" type="number" step="0.01" @bind="_variosAlto" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ancho</label>
                        <input class="form-control" type="number" step="0.01" @bind="_variosAncho" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Largo (opcional)</label>
                        <input class="form-control" type="number" step="0.01" @bind="_variosLargo" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="_variosTieneIlustracion" id="tieneIlustracion" />
                            <label class="form-check-label" for="tieneIlustracion">¿Tiene ilustración?</label>
                        </div>
                    </div>
                </div>
                break;
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        <div class="mt-4">
            <button class="btn btn-primary" type="submit" disabled="@_guardando">
                @(_guardando ? "Guardando..." : "Guardar")
            </button>
            <a class="btn btn-outline-secondary" href="productos">Cancelar</a>
        </div>
    </EditForm>
}

@code {
    // Campos base
    private TipoProducto _tipoSeleccionado = TipoProducto.Funko;
    private string _nombre = string.Empty;
    private decimal _precio;
    private int _unidades;
    private string? _rutaImagenTemporal;

    // Funko
    private int _funkoNumeroBox;
    private string _funkoLicencia = string.Empty;
    private int _funkoSubtipoId;
    private int _funkoCaracteristicaId;

    // Hot Wheels
    private string _hwModelo = string.Empty;
    private int _hwAnio;
    private string _hwSerie = string.Empty;
    private int _hwCategoriaId;

    // TCG
    private int _tcgFranquiciaId;
    private int _tcgExpansionId;
    private int _tcgPackId;
    private ExpansionesYPacksDto? _expansionesYPacks;

    // Toy
    private int _toyEdadMinima;
    private int _toyJugadoresMin;
    private int _toyJugadoresMax;
    private bool _toyEsJuegoMesa;

    // Varios
    private string _variosMarca = string.Empty;
    private string _variosMaterial = string.Empty;
    private decimal _variosAlto;
    private decimal _variosAncho;
    private decimal? _variosLargo;
    private bool _variosTieneIlustracion;

    private CatalogosDto? _catalogos;
    private bool _cargandoCatalogos = true;
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Catálogos necesarios para poblar los combos de detalle (Subtipo,
        // Categoría, Franquicia, etc.) — sin esto habría que hardcodear IDs.
        _catalogos = await Mediator.Send(new ObtenerCatalogosQuery());
        _cargandoCatalogos = false;
    }

    private async Task CargarExpansionesYPacksAsync()
    {
        _tcgExpansionId = 0;
        _tcgPackId = 0;
        _expansionesYPacks = _tcgFranquiciaId > 0
            ? await Mediator.Send(new ObtenerExpansionesYPacksQuery(_tcgFranquiciaId))
            : null;
    }

    private async Task OnImagenSeleccionadaAsync(InputFileChangeEventArgs e)
    {
        // Se limpia cualquier temporal previo si el usuario cambió de
        // archivo antes de enviar el formulario.
        ImagenTemporalHelper.BorrarSiExiste(_rutaImagenTemporal);
        _rutaImagenTemporal = await ImagenTemporalHelper.GuardarComoTemporalAsync(e.File);
    }

    private async Task GuardarAsync()
    {
        _error = null;
        _guardando = true;

        try
        {
            var command = new CrearProductoCommand
            {
                Tipo = _tipoSeleccionado,
                Nombre = _nombre,
                Precio = _precio,
                Unidades = _unidades,
                ImagePath = _rutaImagenTemporal,
                Funko = _tipoSeleccionado == TipoProducto.Funko
                    ? new CrearFunkoDetalleDto(_funkoNumeroBox, _funkoLicencia, _funkoSubtipoId,
                        _funkoCaracteristicaId > 0 ? _funkoCaracteristicaId : null)
                    : null,
                HotWheels = _tipoSeleccionado == TipoProducto.HotWheels
                    ? new CrearHotWheelsDetalleDto(_hwModelo, _hwAnio, _hwSerie, _hwCategoriaId)
                    : null,
                Tcg = _tipoSeleccionado == TipoProducto.Tcg
                    ? new CrearTcgDetalleDto(_tcgPackId, _tcgExpansionId)
                    : null,
                Toy = _tipoSeleccionado == TipoProducto.Toy
                    ? new CrearToyDetalleDto(_toyEdadMinima, _toyJugadoresMin, _toyJugadoresMax, _toyEsJuegoMesa)
                    : null,
                Varios = _tipoSeleccionado == TipoProducto.Varios
                    ? new CrearVariosDetalleDto(_variosMarca, _variosAlto, _variosAncho, _variosLargo, _variosMaterial, _variosTieneIlustracion)
                    : null,
            };

            var resultado = await Mediator.Send(command);

            if (resultado.IsSuccess)
            {
                Navigation.NavigateTo("/productos");
            }
            else
            {
                _error = resultado.Error;
            }
        }
        catch (Exception ex)
        {
            _error = $"Error inesperado al guardar: {ex.Message}";
        }
        finally
        {
            // El temporal ya cumplió su función (Application lo leyó y lo
            // copió a su almacenamiento definitivo, o falló) — no debe
            // quedar basura acumulándose en el servidor.
            ImagenTemporalHelper.BorrarSiExiste(_rutaImagenTemporal);
            _guardando = false;
        }
    }
}
