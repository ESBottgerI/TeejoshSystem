@page "/ventas/historial"
@attribute [Authorize(Roles = AuthorizationConstants.Administrador)]
@rendermode InteractiveServer
@using MediatR
@using TeejoshSystem.Application.Common.Dtos
@using TeejoshSystem.Application.Ports.Inbound.Ventas.Queries.ObtenerVentas
@inject IMediator Mediator

<PageTitle>Historial de Ventas</PageTitle>

<h3>Historial de Ventas</h3>

<div class="row mb-3 g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label">Desde</label>
        <input type="date" class="form-control" @bind="_desde" />
    </div>
    <div class="col-auto">
        <label class="form-label">Hasta</label>
        <input type="date" class="form-control" @bind="_hasta" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="FiltrarAsync">Filtrar</button>
    </div>
    <div class="col-auto">
        <button class="btn btn-link" @onclick="LimpiarAsync">Limpiar</button>
    </div>
</div>

@if (_cargando)
{
    <LoadingIndicator Mensaje="Cargando ventas..." />
}
else if (_error is not null)
{
    <ErrorAlert Mensaje="@_error" />
}
else if (_ventas.Count == 0)
{
    <p>No hay ventas registradas en ese rango.</p>
}
else
{
    @foreach (var venta in _ventas)
    {
        <div class="card mb-2">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Venta #@venta.Id — @venta.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                <strong>Total: S/ @venta.Total.ToString("0.00")</strong>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var detalle in venta.Detalles)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@detalle.NombreProducto x @detalle.Cantidad</span>
                        <span>S/ @detalle.Subtotal.ToString("0.00")</span>
                    </li>
                }
            </ul>
        </div>
    }
}

@code {
    private DateTime? _desde;
    private DateTime? _hasta;
    private List<VentaDto> _ventas = new();
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task FiltrarAsync() => await CargarAsync();

    private async Task LimpiarAsync()
    {
        _desde = null;
        _hasta = null;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            var ventas = await Mediator.Send(new ObtenerVentasQuery(_desde, _hasta));
            _ventas = ventas.ToList();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el historial: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }
}
