@using System.Security.Claims
@inject TeejoshSystem.WebUI.Infrastructure.Auth.CustomAuthenticationStateProvider AuthProvider
@inject CircuitStateStore StateStore
@inject NavigationManager Navigation

<header class="top-header">
    <span class="session-label">Sesión activa</span>
    <AuthorizeView>
        <Authorized>
            <div class="user-chip" aria-label="Usuario activo">
                <span>@context.User.FindFirstValue(ClaimTypes.Name)</span>
                <button type="button" class="link-button" @onclick="CerrarSesionAsync">Salir</button>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

@code {
    private async Task CerrarSesionAsync()
    {
        StateStore.Clear();
        await AuthProvider.SignOutAsync();
        Navigation.NavigateTo("/login");
    }
}
