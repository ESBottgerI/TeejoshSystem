@page "/inventario"
@attribute [Authorize(Roles = "Administrador,Operador")]
@using TeejoshSystem.Application.Common.Dtos
@using TeejoshSystem.Application.Ports.Inbound.Productos.Queries.BuscarProductos
@using TeejoshSystem.Application.Ports.Inbound.Productos.Queries.ObtenerProductos
@using TeejoshSystem.Domain.Enums
@inject IMediator Mediator

<PageHeader Title="Inventario" Eyebrow="Stock general" />

<form class="toolbar" @onsubmit="BuscarAsync" @onsubmit:preventDefault="true">
    <input class="input" placeholder="Buscar por nombre" @bind="Nombre" aria-label="Buscar por nombre" />
    <select class="input" @bind="Tipo" aria-label="Filtrar por tipo">
        <option value="">Todos</option>
        @foreach (var tipo in Enum.GetValues<TipoProducto>())
        {
            <option value="@tipo">@tipo</option>
        }
    </select>
    <CustomButton Type="submit" IsBusy="IsBusy">Buscar</CustomButton>
</form>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p class="field-error" role="alert">@ErrorMessage</p>
}
<InventarioTableGrid Items="Productos" />
<LoadingOverlay IsVisible="IsBusy" Message="Consultando inventario" />

@code {
    private string? Nombre { get; set; }
    private TipoProducto? Tipo { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private List<ProductoBusquedaDto> Productos { get; set; } = new();

    protected override async Task OnInitializedAsync() => await BuscarAsync();

    private async Task BuscarAsync()
    {
        if (IsBusy) return;
        IsBusy = true;
        ErrorMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Nombre) && Tipo is null)
                await CargarListadoAsync();
            else
                Productos = await Mediator.Send(new BuscarProductosQuery(Nombre, Tipo));
        }
        catch (Exception ex)
        {
            ErrorMessage = "No se pudo cargar el inventario: " + ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task CargarListadoAsync()
    {
        var productos = await Mediator.Send(new ObtenerProductosQuery());
        Productos = productos.Select(ToBusquedaDto).ToList();
    }

    private static ProductoBusquedaDto ToBusquedaDto(ProductoDto producto) => new()
    {
        Id = producto.Id,
        Tipo = producto.Tipo,
        Nombre = producto.Nombre,
        Precio = producto.Precio,
        Unidades = producto.Unidades,
        TieneImagen = producto.TieneImagen,
        DetalleResumen = producto.DetalleResumen
    };
}
