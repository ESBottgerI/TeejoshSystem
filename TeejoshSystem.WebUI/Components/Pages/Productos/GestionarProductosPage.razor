@page "/productos"
@attribute [Authorize(Roles = "Administrador")]
@using TeejoshSystem.Application.Common
@using TeejoshSystem.Application.Ports.Inbound.Productos.Commands.EliminarProducto
@using TeejoshSystem.Application.Ports.Inbound.Productos.Queries.BuscarProductos
@inject IMediator Mediator
@inject BlazorNotificationService Notifications

<PageHeader Title="Gestionar productos" Eyebrow="Operación"><Actions><a class="btn primary" href="/productos/crear">Nuevo producto</a></Actions></PageHeader>

<ResultErrorDisplay Result="_eliminarResult" />

<div class="table-shell">
    <table class="data-table">
        <thead>
            <tr><th>Producto</th><th>Tipo</th><th>Precio</th><th><span class="stock-heading">Stock <button class="icon-button" aria-label="Alternar cantidades de stock" @onclick="ToggleStock">@(_showStock ? "👁" : "◉")</button></span></th><th>Detalle</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var producto in Productos)
            {
                <tr>
                    <td data-label="Producto" class="product-name-cell"><ProductIdentityCell ProductId="producto.Id" Name="producto.Nombre" HasImage="producto.TieneImagen" Href="@($"/productos/{producto.Id}")" /></td>
                    <td data-label="Tipo">@producto.Tipo</td>
                    <td data-label="Precio">@SolesFormatter.Format(producto.Precio)</td>
                    <td data-label="Stock"><button class="link-button" @onclick="() => ToggleRow(producto.Id)">@StockText(producto)</button></td>
                    <td data-label="Detalle">@producto.DetalleResumen</td>
                    <td data-label="Acciones" class="toolbar" style="margin:0">
                        <a class="btn secondary" href="/productos/editar/@producto.Id">Editar</a>
                        <button class="btn danger" @onclick="() => ConfirmarEliminar(producto)" disabled="@_isBusy">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_productoAEliminar is not null)
{
    <div class="loading-overlay" style="cursor:default" @onclick:stopPropagation="true">
        <div class="auth-card" style="width:auto;max-width:28rem" @onclick:stopPropagation>
            <h2>Confirmar eliminacion</h2>
            <p>Esta seguro de eliminar el producto <strong>@_productoAEliminar.Nombre</strong>?</p>
            <div class="toolbar" style="justify-content:end">
                <button class="btn secondary" @onclick="CancelarEliminar" disabled="@_isBusy">Cancelar</button>
                <button class="btn danger" @onclick="EliminarAsync" disabled="@_isBusy">
                    @if (_isBusy) { <span class="spinner"></span> }
                    Eliminar
                </button>
            </div>
        </div>
    </div>
}

<LoadingOverlay IsVisible="_isBusy && _productoAEliminar is null" Message="Cargando..." />

@code {
    private List<ProductoBusquedaDto> Productos { get; set; } = new();
    private ProductoBusquedaDto? _productoAEliminar;
    private Result? _eliminarResult;
    private bool _isBusy;
    private bool _showStock = true;
    private readonly HashSet<int> _revealedStock = new();
    private void ToggleStock() { _showStock = !_showStock; _revealedStock.Clear(); }
    private void ToggleRow(int id) { if (!_revealedStock.Add(id)) _revealedStock.Remove(id); }
    private string StockText(ProductoBusquedaDto item) => _showStock || _revealedStock.Contains(item.Id) ? item.Unidades.ToString() : item.Unidades > 0 ? "Disponible" : "Sin stock";

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _isBusy = true;
        Productos = await Mediator.Send(new BuscarProductosQuery(null, null));
        _isBusy = false;
    }

    private void ConfirmarEliminar(ProductoBusquedaDto producto)
    {
        _productoAEliminar = producto;
    }

    private void CancelarEliminar()
    {
        _productoAEliminar = null;
    }

    private async Task EliminarAsync()
    {
        if (_productoAEliminar is null) return;

        _isBusy = true;
        _eliminarResult = null;
        var id = _productoAEliminar.Id;
        var result = await Mediator.Send(new EliminarProductoCommand(new List<int> { id }));
        _isBusy = false;
        _productoAEliminar = null;
        _eliminarResult = result;

        if (result.IsSuccess)
        {
            await Notifications.ShowSuccessAsync("Producto eliminado.");
            await CargarAsync();
        }
        else
        {
            await Notifications.ShowErrorAsync(result.Error ?? "No se pudo eliminar el producto.");
        }
    }
}
