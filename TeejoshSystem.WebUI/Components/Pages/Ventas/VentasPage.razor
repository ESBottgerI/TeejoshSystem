@page "/ventas"
@attribute [Authorize(Roles = "Administrador,Operador")]
@using TeejoshSystem.Application.Common
@using TeejoshSystem.Application.Ports.Inbound.Productos.Queries.BuscarProductos
@using TeejoshSystem.Application.Ports.Inbound.Ventas.Commands.RegistrarVenta
@inject IMediator Mediator
@inject CircuitStateStore StateStore
@inject BlazorNotificationService Notifications
@inject BlazorConfirmationService Confirmation

<PageHeader Title="Ventas" Eyebrow="Punto de venta"><Actions><a class="btn secondary" href="/ventas/historial">Ver historial</a></Actions></PageHeader>

<ResizableSalesSplit>
  <Products>
    <div>
        <form class="toolbar" @onsubmit="BuscarAsync" @onsubmit:preventDefault="true">
            <input class="input" placeholder="Buscar producto" @bind="Nombre" aria-label="Buscar producto para venta" />
            <CustomButton Type="submit" IsBusy="IsBusy">Buscar</CustomButton>
        </form>
        <div class="table-shell">
            <table class="data-table">
                <thead><tr><th>Producto</th><th>Precio</th><th><span class="stock-heading">Stock <button class="icon-button" aria-label="Alternar cantidades de stock" @onclick="ToggleStock">@(_showStock ? "👁" : "◉")</button></span></th><th></th></tr></thead>
                <tbody>
                    @foreach (var producto in Productos)
                    {
                        <tr>
                            <td data-label="Producto" class="product-name-cell"><ProductIdentityCell ProductId="producto.Id" Name="producto.Nombre" HasImage="producto.TieneImagen" /></td>
                            <td data-label="Precio">@SolesFormatter.Format(producto.Precio)</td>
                            <td data-label="Stock"><button class="link-button" @onclick="() => ToggleRow(producto.Id)">@StockText(producto)</button></td>
                            <td data-label="Acción"><button class="btn primary" disabled="@(producto.Unidades <= 0)" @onclick="() => Agregar(producto)">Agregar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
  </Products>
  <Cart><CarritoVenta OnConfirm="RegistrarAsync" /></Cart>
</ResizableSalesSplit>

<ResultErrorDisplay Result="_ventaResult" />

@code {
    private string? Nombre { get; set; }
    private bool IsBusy { get; set; }
    private List<ProductoBusquedaDto> Productos { get; set; } = new();
    private Result<int>? _ventaResult;
    private bool _showStock = true;
    private readonly HashSet<int> _revealedStock = new();
    private void ToggleStock() { _showStock = !_showStock; _revealedStock.Clear(); }
    private void ToggleRow(int id) { if (!_revealedStock.Add(id)) _revealedStock.Remove(id); }
    private string StockText(ProductoBusquedaDto item) => _showStock || _revealedStock.Contains(item.Id) ? item.Unidades.ToString() : item.Unidades > 0 ? "Disponible" : "Sin stock";

    protected override async Task OnInitializedAsync() => await BuscarAsync();

    private async Task BuscarAsync()
    {
        IsBusy = true;
        Productos = await Mediator.Send(new BuscarProductosQuery(Nombre, null));
        IsBusy = false;
    }

    private void Agregar(ProductoBusquedaDto producto)
        => StateStore.AddOrIncrement(producto.Id, producto.Nombre, producto.Precio, producto.Unidades);

    private async Task RegistrarAsync()
    {
        if (StateStore.CartItems.Count == 0) return;
        if (!await Confirmation.ConfirmAsync($"¿Registrar la venta por {SolesFormatter.Format(StateStore.CartItems.Sum(i => i.Subtotal))}?", "Confirmar venta")) return;

        IsBusy = true;
        _ventaResult = null;
        var command = new RegistrarVentaCommand(StateStore.CartItems
            .Select(i => new RegistrarVentaItemCommand(i.ProductId, i.Quantity))
            .ToList());
        var result = await Mediator.Send(command);
        IsBusy = false;
        _ventaResult = result;

        if (result.IsSuccess)
        {
            StateStore.Clear();
            await Notifications.ShowSuccessAsync($"Venta registrada #{result.Value}.");
            await BuscarAsync();
        }
        else
        {
            await Notifications.ShowErrorAsync(result.Error ?? "No se pudo registrar la venta.");
        }
    }
}
