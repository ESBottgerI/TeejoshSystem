<div class="field">
    <label for="@Id">@Label</label>
    <input id="@Id" class="input" type="number" step="@Step" value="@Value" @oninput="OnInput" disabled="@Disabled" aria-invalid="@(!string.IsNullOrWhiteSpace(Error))" />
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="field-error" role="alert">@Error</p>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public string Step { get; set; } = "1";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task OnInput(ChangeEventArgs args)
    {
        if (decimal.TryParse(args.Value?.ToString(), out var value))
            await ValueChanged.InvokeAsync(value);
    }
}
